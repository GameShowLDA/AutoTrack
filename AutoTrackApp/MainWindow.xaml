<Window x:Class="AutoTrackApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoTrackApp"
        xmlns:TopPanel="clr-namespace:AutoTrackApp.UI.Components.TopPanel"
        xmlns:UserTabs="clr-namespace:AutoTrackApp.UI.Components.UserTabs"
         xmlns:Card="clr-namespace:AutoTrackApp.UI.Components.UserCard"
        mc:Ignorable="d"
        
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        WindowState="Maximized"
        
        Title="MainWindow" Height="450" Width="800"
        >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <TopPanel:TopPanelComponent Grid.Row="0"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <UserTabs:UserTabList Margin="10" x:Name="UsersList"/>
            <Card:UserProfilePanel x:Name="UserProfilePanel"
                       Grid.Column="1"
                       Margin="10"
                       DataContext="{Binding ElementName=UsersList, Path=DataContext.SelectedUser}"
                       Visibility="{Binding ElementName=UsersList, Path=DataContext.SelectedUser, Converter={StaticResource NullToVisibilityConverter}}"/>
        </Grid>
    </Grid>
</Window>
