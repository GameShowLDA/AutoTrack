<Application x:Class="AutoTrackApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AutoTrackApp"
             xmlns:conv="clr-namespace:AutoTrackApp.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <conv:StringNullOrEmptyToVisibilityConverter x:Key="StringNullOrEmptyToVisibilityConverter"/>
        <conv:SelectedTabBackgroundConverter x:Key="SelectedTabBackgroundConverter"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <conv:BoolToBrushConverter x:Key="BoolToBrushConverter" TrueBrush="#fff1f1" FalseBrush="Transparent"/>

    </Application.Resources>
</Application>
