<UserControl x:Class="AutoTrackApp.UI.Components.UserTabs.UserTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="40" MinWidth="200">
    <Border x:Name="TabBorder"
            Margin="0,4,0,0"
            Padding="10,0"
            Background="{Binding IsSelected, Converter={StaticResource SelectedTabBackgroundConverter}}"
            CornerRadius="8">
        <TextBlock Text="{Binding UserName, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   VerticalAlignment="Center"
                   FontSize="18"
                   Foreground="Black"/>
    </Border>
</UserControl>