<UserControl x:Class="AutoTrackApp.UI.Components.UserCard.UserCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AutoTrackApp.UI.Components.UserCard"
             xmlns:icons="clr-namespace:AutoTrackApp.UI.Components.Icons"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             MinWidth="500" MinHeight="120"
             Background="Transparent">
    <Border Background="White"
            CornerRadius="16"
            Padding="16"
            Margin="0,8,0,12"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- Круг с инициалами, центрирование по вертикали -->
            <Grid Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Ellipse Width="72" Height="72">
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#b4e0ff" Offset="0"/>
                            <GradientStop Color="#a5b4fc" Offset="1"/>
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock Text="{Binding Initials}" 
                           VerticalAlignment="Center" 
                           HorizontalAlignment="Center"
                           FontWeight="Bold"
                           FontSize="28"
                           Foreground="White"/>
            </Grid>
            <!-- Информация о пользователе -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center"  x:Name="UserCardRoot">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding LastName}" 
                                 IsReadOnly="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBooleanConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}"
                                 FontWeight="Bold" FontSize="28" Margin="0,0,2,2"
                                 x:Name="LastNameTextBox"/>
                        <TextBox Text="{Binding FirstName}" 
                                 IsReadOnly="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBooleanConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}"
                                 Grid.Column="1" FontWeight="Bold" FontSize="28" Margin="0,0,2,2"
                                 x:Name="FirstNameTextBox"/>
                        <TextBox Text="{Binding Patronymic}" 
                                 IsReadOnly="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBooleanConverter}}" 
                                 Style="{StaticResource EditableTextBoxStyle}"
                                 Grid.Column="2" FontWeight="Bold" FontSize="28" Margin="0,0,2,2"
                                 x:Name="PatronymicTextBox"/>
                    </Grid>

                    <Border Background="Transparent" CornerRadius="6" Cursor="Hand"
                            VerticalAlignment="Center" Margin="0,0,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="icons:PencilIcon.IconFill" Value="#3B82F6"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#e0f2fe"/>
                                        <Setter Property="icons:PencilIcon.IconFill" Value="#2563eb"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <icons:PencilIcon x:Name="Edit" Size="20" IconFill="#3B82F6" MouseLeftButtonDown="EditIcon_MouseDown" Visibility="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBooleanConverter}}" />
                            <icons:CheckIcon x:Name="SaveButton" Size="20" MouseLeftButtonDown="SaveButton_PreviewMouseDown" Visibility="Collapsed"/>
                            <icons:CloseIcon x:Name="CancelButton" Size="20" MouseLeftButtonDown="CancelButton_PreviewMouseDown" Visibility="Collapsed" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="день рождения:" FontSize="15" Foreground="#666" Margin="0,0,0,2"/>
                    <TextBox Grid.Column="1" Text="{Binding DateOfBirth, StringFormat=' {0:dd.MM.yyyy}'}" 
                             IsReadOnly="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBooleanConverter}}" 
                             Style="{StaticResource EditableTextBoxStyle}"
                             FontSize="15" Foreground="#666"
                                 x:Name="DateOfBirthTextBox"/>

                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="эл. почта:" FontSize="15" Foreground="#666" Margin="0,0,0,2"/>
                    <TextBox Grid.Column="1" Text="{Binding Email, StringFormat=' {0}'}" 
                             IsReadOnly="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBooleanConverter}}" 
                             Style="{StaticResource EditableTextBoxStyle}"
                             FontSize="15" Foreground="#666"
                             x:Name="EmailTextBox"/>

                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="моб. телефон:" FontSize="15" Foreground="#666"/>
                    <TextBox Grid.Column="1" Text="{Binding Phone, StringFormat=' {0}'}" 
                             IsReadOnly="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBooleanConverter}}" 
                             Style="{StaticResource EditableTextBoxStyle}"
                             FontSize="15" Foreground="#666"
                             x:Name="PhoneTextBox"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
