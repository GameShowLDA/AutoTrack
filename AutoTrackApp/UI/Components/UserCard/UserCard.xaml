<UserControl x:Class="AutoTrackApp.UI.Components.UserCard.UserCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AutoTrackApp.UI.Components.UserCard"
             xmlns:icons="clr-namespace:AutoTrackApp.UI.Components.Icons"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             MinWidth="500" MinHeight="120"
             Background="Transparent">
        <Border Background="White"
            CornerRadius="16"
            Padding="16"
            Margin="0,8,0,12"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- Круг с инициалами, центрирование по вертикали -->
            <Grid Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Ellipse Width="72" Height="72">
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#b4e0ff" Offset="0"/>
                            <GradientStop Color="#a5b4fc" Offset="1"/>
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock Text="{Binding Initials}" 
                           VerticalAlignment="Center" 
                           HorizontalAlignment="Center"
                           FontWeight="Bold"
                           FontSize="28"
                           Foreground="White"/>
            </Grid>
            <!-- Информация о пользователе -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FullName}" FontWeight="Bold" FontSize="28" Margin="0,0,4,0"/>
                    <Border Width="28" Height="28" Background="Transparent" CornerRadius="6" Cursor="Hand"
                            VerticalAlignment="Center" Margin="0,0,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="icons:PencilIcon.IconFill" Value="#3B82F6"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#e0f2fe"/>
                                        <Setter Property="icons:PencilIcon.IconFill" Value="#2563eb"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <icons:PencilIcon Size="20" IconFill="#3B82F6"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding DateOfBirth, StringFormat='день рождения: {0:dd.MM.yyyy}'}" FontSize="15" Foreground="#666" Margin="0,0,0,2"/>
                <TextBlock Text="{Binding Email, StringFormat='эл. почта: {0}'}" FontSize="15" Foreground="#666" Margin="0,0,0,2"/>
                <TextBlock Text="{Binding Phone, StringFormat='моб. телефон: {0}'}" FontSize="15" Foreground="#666"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
