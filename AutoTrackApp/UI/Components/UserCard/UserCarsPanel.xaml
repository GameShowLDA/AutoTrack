<UserControl x:Class="AutoTrackApp.UI.Components.UserCard.UserCarsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="600"
             Background="#f5f5fa">

    <!-- ContentRoot нужен для внутреннего DataContext -->
    <Border x:Name="ContentRoot" Background="White" CornerRadius="12" Padding="16" Margin="0,8,0,0">
        <StackPanel>

            <!-- Заголовки -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Марка" FontWeight="Bold" FontSize="18"/>
                <TextBlock Text="Модель" Grid.Column="1" FontWeight="Bold"  FontSize="18"/>
                <TextBlock Text="Гос. номер" Grid.Column="2" FontWeight="Bold"  FontSize="18"/>
                <TextBlock Text="VIN" Grid.Column="3" FontWeight="Bold"  FontSize="18"/>
            </Grid>

            <!-- Список авто -->
            <ListBox ItemsSource="{Binding UserCars}"
                     SelectedItem="{Binding SelectedCar, Mode=TwoWay}"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">

                <ListBox.Resources>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,2"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter Margin="4,2"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#fdecec"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                                <Condition Property="IsSelected" Value="False"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="Bd" Property="Background" Value="#f3f6fb"/>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.Resources>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Make}" FontSize="18" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Model}" FontSize="18" Grid.Column="1" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding LicensePlate}" FontSize="18" Grid.Column="2" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Vin}" FontSize="18" Grid.Column="3" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </StackPanel>
    </Border>
</UserControl>
