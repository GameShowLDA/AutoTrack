<UserControl x:Class="AutoTrackApp.UI.Components.UserCard.UserProfilePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AutoTrackApp.UI.Components.UserCard"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             MinWidth="600" Background="#f5f5fa">
    <StackPanel Margin="16">
        <!-- Карточка пользователя -->
        <local:UserCard DataContext="{Binding}"  x:Name="UserCardPanel"  />

        <!-- Здесь будут секции для машин и работ -->
        <local:UserCarsPanel x:Name="UserCarsPanel" />
        <local:UserWorksPanel x:Name="UserWorksPanel" DataContext="{Binding CarWorks}"/>
    </StackPanel>
</UserControl>
